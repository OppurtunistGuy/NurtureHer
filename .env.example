# Server only. Use different durable paths for dev, UAT and production.
NOCTURNE_DB_PATH=data/nocturne.sqlite
# Hosted shared storage: use a separate primary Turso/libSQL database for UAT.
# Both are server-only; never use VITE_ prefixes. Vercel requires these values.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# AI drafting: choose direct OpenAI OR Vercel AI Gateway.
# Direct OpenAI (server-only). Model defaults to gpt-4.1-mini when omitted.
OPENAI_API_KEY=
OPENAI_ROUTINE_MODEL=
# On Vercel, OIDC runtime identity can authenticate to Gateway without a provider key.
# Local/external hosts can use AI_GATEWAY_API_KEY instead. Never use a VITE_ prefix.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-4.1-mini
# Optional private Telegram bot, without @. Set its webhook separately over HTTPS.
TELEGRAM_BOT_USERNAME=
# Generate a random secret of at least 32 characters; never commit a real secret.
TELEGRAM_WEBHOOK_SECRET=
