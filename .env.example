# Server only. Use different durable paths for dev, UAT and production.
NOCTURNE_DB_PATH=data/nocturne.sqlite
# Optional AI drafting. Choose a Responses API model supporting Structured Outputs.
OPENAI_API_KEY=
OPENAI_ROUTINE_MODEL=
# Optional private Telegram bot, without @. Set its webhook separately over HTTPS.
